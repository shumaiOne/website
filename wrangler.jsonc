{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-06-04",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "shumai.one",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "404-page"
  },
  "compatibility_flags": ["nodejs_compat"]
}
